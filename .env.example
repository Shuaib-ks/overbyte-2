# Local development requires none of these variables and uses data/overbyte.sqlite.
# For Vercel, add all three in Project Settings > Environment Variables.
# Use a libSQL-backed Turso database, not a local SQLite path or embedded replica.
TURSO_DATABASE_URL=libsql://your-database-your-organization.turso.io
TURSO_AUTH_TOKEN=replace-with-your-database-auth-token
CRON_SECRET=replace-with-a-long-random-secret

# Optional when running the Node server directly outside Vercel:
# HOST=127.0.0.1
# PORT=3000
# OVERBYTE_DB=data/overbyte.sqlite
# COOKIE_SECURE=true
